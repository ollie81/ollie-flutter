<?xml version="1.0" encoding="utf-8"?>
<!-- Same as drawable/launch_background.xml -- the app's own dark
     background rather than the system theme's, since this app is
     always dark (see main.dart's ThemeData) regardless of the
     device's light/dark setting. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="#0D0F1A" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
